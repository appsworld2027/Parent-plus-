{
  "organization": "appsworld",
  "adapterVersion": "2",
  "source": "appsworld2027/parent-plus-ai-org",
  "handbook": {
    "repo": "appsworld2027/parent-plus-ai-org",
    "ref": "main",
    "entry": "AGENTS.md"
  },
  "product": {
    "name": "Parent Plus",
    "testUrl": "https://parent-plus-varcel.vercel.app",
    "docsFolder": "docs/product"
  },
  "commands": {
    "check": "npm run check",
    "e2e": "npm run test:e2e",
    "exportWeb": "npm run export:web",
    "exportAndroid": "npm run export:android"
  },
  "database": {
    "migrationsFolder": "supabase/migrations",
    "devProject": "see config/public-client.json and the 'Supabase and release safety' section of AGENTS.md"
  },
  "quality": {
    "handbookSection": "AGENTS.md §7A",
    "contractPath": "docs/product/<feature-slug>/ACCEPTANCE.md",
    "acceptanceTestsPath": "e2e/acceptance/",
    "acceptanceCommand": "npx playwright test e2e/acceptance",
    "contractLockWorkflow": ".github/workflows/contract-lock.yml",
    "stopHook": ".claude/hooks/quality-gate.sh",
    "stopHookCommand": "npm run check"
  },
  "governance": {
    "ownerRulesFile": "AGENTS.md",
    "autoMerge": false,
    "note": "Agents open pull requests. The AI Org loop merges reviewed build PRs into their feature branch only; a founder /approve ships the delivery PR to main.",
    "founders": [
      "appsworld2027"
    ],
    "approvalRule": "One founder's /approve is sufficient (decided by Ankit on 2026-11-22: 'Manu is onboarded; if I approve decisions, that counts'). Agents never merge to main without a founder /approve on the exact green head commit."
  },
  "entrypoints": {
    "founderCommand": "scripts/founder-command.mjs",
    "founderInterface": ".codex/FOUNDER_COMMANDS.md",
    "discoveryWorkflow": ".github/workflows/ai-pm-discovery.yml",
    "intakeWorkflow": ".github/workflows/founder-intake.yml",
    "planningWorkflow": ".github/workflows/product-planning.yml",
    "qaWorkflow": ".github/workflows/multi-agent-qa.yml"
  },
  "protectedActions": [
    "production",
    "destructive",
    "paid",
    "credentials",
    "legal-privacy"
  ],
  "loop": {
    "backlog": "docs/product/BACKLOG.md",
    "maxFixRounds": 5,
    "agentsWorkflow": "ai-agents.yml",
    "checksWorkflow": "checks.yml",
    "qaWorkflow": "qa-lab.yml",
    "requiredChecks": [
      "foundation"
    ],
    "lockedPaths": "e2e/acceptance/"
  },
  "memory": {
    "folder": "docs/ai-memory",
    "rule": "Agents propose in handover '## Memory proposals'; Arjun (AI CPTO) merges via reviewed PR."
  },
  "raci": {
    "ai:tests": {
      "responsible": "quinn-qa@author",
      "reviewer": "quinn-qa@challenger",
      "consulted": [
        "maya-ai-pm (product intent, read-only)"
      ],
      "accountable": "arjun-cpto",
      "informed": [
        "dev-coder (via handover packet)"
      ],
      "models": {
        "author": "nvidia_nim/moonshotai/kimi-k3.1-pro@medium",
        "challenger": "nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b",
        "accountable": "nvidia_nim/moonshotai/kimi-k3.1-pro@medium"
      },
      "evidence": "AI Org model trial 3 (issue #66): both models PASS 18/18; author and challenger on different models"
    }
  }
}
