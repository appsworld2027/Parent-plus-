{
  "name": "parentplus-coach",
  "version": "0.13.1",
  "main": "index.ts",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "fast-text-encoding": "^1.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.0",
    "@types/react": "~19.3.0",
    "eslint": "10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workspace:postgres": "node scripts/test-workspace-concurrency.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "export:web": "expo export --platform web",
    "prepare:owner-sql": "node scripts/prepare-owner-sql.mjs",
    "prepare:parent-sql": "node scripts/prepare-parent-sql.mjs",
    "prepare:identity-sql": "node scripts/prepare-identity-sql.mjs",
    "lint": "eslint .",
    "quality:plan": "python3 scripts/quality_gate.py plan",
    "quality:verify": "python3 scripts/quality_gate.py verify",
    "quality:self-test": "python3 -m unittest discover -s tests/quality -v",
    "quality:run": "python3 scripts/quality_gate.py run",
    "test:parent:postgres": "node scripts/test-parent-attendance-postgres.mjs"
  },
  "private": true,
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.1"
    }
  }
}
